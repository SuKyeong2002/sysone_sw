package app.labs.ex01;

public class Subway implements Transportation{
     
	private int lineNumber;
    private int passengerCount;
    private int money;

	@Override
    public void getIn(Passanger pass) {
        this.passengerCount++;
        this.money += 1500;
        pass.withdraw(1500);
        
        System.out.println(this.toString());
        System.out.println(pass.toString());
    }

    @Override
    public void getOut(Passanger pass) {
        this.passengerCount--;
        
        System.out.println(this.toString());
        System.out.println(pass.toString()); 
    }
    
    @Override
    public String toString() {
        return "Bus lineNumber=" + lineNumber + ", passengerCount=" + passengerCount + ", money=" + money + "]";
    }

}